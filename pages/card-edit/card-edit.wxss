.add-form {
  margin-bottom: 24rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}

.input {
  height: 80rpx;
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.tpl-hint {
  display: block;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.field-row {
  margin-bottom: 16rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.list-title {
  font-size: 26rpx;
  margin: 24rpx 8rpx 16rpx;
}

.card-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-content {
  flex: 1;
  min-width: 0;
}

.card-front {
  font-size: 30rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
  white-space: pre-wrap;
}

.card-back {
  font-size: 26rpx;
  white-space: pre-wrap;
}

.del {
  color: var(--danger);
  font-size: 26rpx;
  padding-left: 24rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
}
