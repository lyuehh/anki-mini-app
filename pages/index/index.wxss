.hero {
  padding: 40rpx 8rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 26rpx;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.stat {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.stat-num {
  font-size: 60rpx;
  font-weight: 700;
  color: var(--primary);
}

.stat-num.due {
  color: var(--warning);
}

.stat-num.mastered {
  color: var(--success);
}

.stat-label {
  font-size: 26rpx;
  margin-top: 8rpx;
}
