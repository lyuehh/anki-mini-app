.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  padding: 44rpx 36rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  border: none;
  box-shadow: 0 14rpx 36rpx rgba(79, 110, 247, 0.32);
}

.hero-text {
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
}

.hero-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-emoji {
  font-size: 76rpx;
  line-height: 1;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22rpx;
}

.stat {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 36rpx;
}

.stat-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 18rpx;
}

.icon-deck { background: rgba(79, 110, 247, 0.12); }
.icon-card { background: rgba(124, 92, 255, 0.12); }
.icon-due { background: rgba(245, 165, 36, 0.14); }
.icon-mastered { background: rgba(47, 185, 116, 0.14); }

.stat-num {
  font-size: 60rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.1;
}

.stat-num.due {
  color: var(--warning);
}

.stat-num.mastered {
  color: var(--success);
}

.stat-label {
  font-size: 26rpx;
  margin-top: 8rpx;
}

/* 语言切换 */
.lang {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.lang-label {
  font-size: 28rpx;
}

.lang-opts {
  display: flex;
  gap: 16rpx;
}

.lang-opt {
  padding: 12rpx 30rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: var(--text-muted);
  background: var(--primary-soft);
  border: 2rpx solid transparent;
}

.lang-opt.active {
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 600;
  background: #fff;
}
