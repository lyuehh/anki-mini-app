.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
  gap: 16rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.btn-import {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  box-shadow: none;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.btn-add {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  border-radius: 30rpx;
  margin: 0;
  box-shadow: 0 6rpx 16rpx rgba(79, 110, 247, 0.28);
}

.btn-add::after {
  border: none;
}

.deck {
  position: relative;
  margin-bottom: 22rpx;
  padding-left: 34rpx;
  overflow: hidden;
}

.deck::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 10rpx;
  background: linear-gradient(to bottom, var(--primary), var(--accent));
}

.deck-info {
  margin-bottom: 22rpx;
}

.deck-name {
  font-size: 34rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 14rpx;
}

.deck-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.due-badge {
  background: linear-gradient(135deg, var(--warning), #f7b955);
  color: #fff;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.deck-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.tpl-badge {
  background: var(--primary-soft);
  color: var(--primary);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.btn-sm {
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  margin: 0;
  box-shadow: 0 4rpx 12rpx rgba(79, 110, 247, 0.24);
}

.btn-sm::after {
  border: none;
}

.btn-sm.btn-outline {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  box-shadow: none;
}

.btn-sm.btn-danger {
  background: #fff;
  color: var(--danger);
  border: 2rpx solid var(--danger);
  box-shadow: none;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}
