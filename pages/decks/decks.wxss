.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.btn-add {
  background-color: var(--primary);
  color: #fff;
  border-radius: 12rpx;
}

.deck {
  margin-bottom: 20rpx;
}

.deck-info {
  margin-bottom: 20rpx;
}

.deck-name {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 10rpx;
}

.deck-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
}

.due-badge {
  background-color: var(--warning);
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.deck-actions {
  display: flex;
  gap: 16rpx;
}

.btn-sm {
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
  background-color: var(--primary);
  color: #fff;
  margin: 0;
}

.btn-sm.btn-outline {
  background-color: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.btn-sm.btn-danger {
  background-color: transparent;
  color: var(--danger);
  border: 2rpx solid var(--danger);
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}
