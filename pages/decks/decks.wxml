<view class="container">
  <view class="header">
    <text class="title">{{i18n.decks.title}}</text>
    <view class="header-actions">
      <button class="btn btn-add btn-import" size="mini" bindtap="onImportCsv">{{i18n.decks.importCsv}}</button>
      <button class="btn btn-add" size="mini" bindtap="onAddDeck">{{i18n.decks.add}}</button>
    </view>
  </view>

  <block wx:if="{{decks.length > 0}}">
    <view class="deck card" wx:for="{{decks}}" wx:key="id">
      <view class="deck-info">
        <text class="deck-name">{{item.name}}</text>
        <view class="deck-meta">
          <text class="text-muted">{{item.totalText}}</text>
          <text class="due-badge" wx:if="{{item.due > 0}}">{{item.dueText}}</text>
          <text class="text-muted" wx:else>{{item.dueText}}</text>
        </view>
        <view class="deck-meta">
          <text class="tpl-badge" wx:if="{{item.templateName}}">{{item.tplText}}</text>
          <text class="text-muted" wx:else>{{item.tplText}}</text>
        </view>
      </view>
      <view class="deck-actions">
        <button class="btn btn-sm" size="mini" data-id="{{item.id}}" bindtap="onStudy">{{i18n.decks.study}}</button>
        <button class="btn btn-sm btn-outline" size="mini" data-id="{{item.id}}" bindtap="onManage">{{i18n.decks.manage}}</button>
        <button class="btn btn-sm btn-outline" size="mini" data-id="{{item.id}}" bindtap="onChangeTemplate">{{i18n.decks.templateBtn}}</button>
        <button class="btn btn-sm btn-danger" size="mini" data-id="{{item.id}}" bindtap="onDelete">{{i18n.decks.delete}}</button>
      </view>
    </view>
  </block>

  <view class="empty" wx:else>
    <text class="text-muted">{{i18n.decks.empty}}</text>
  </view>
</view>
