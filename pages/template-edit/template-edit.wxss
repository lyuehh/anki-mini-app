.section {
  margin-bottom: 24rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}

.input {
  height: 80rpx;
  border: 2rpx solid var(--border);
  border-radius: 14rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  flex: 1;
  background: #fafbff;
}

.add-field {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.add-field .btn-sm {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  margin: 0;
  box-shadow: 0 4rpx 12rpx rgba(79, 110, 247, 0.24);
}

.add-field .btn-sm::after {
  border: none;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.chip {
  display: flex;
  align-items: center;
  background-color: var(--primary-soft);
  border: 2rpx solid var(--primary);
  border-radius: 30rpx;
  padding: 8rpx 12rpx 8rpx 20rpx;
}

.chip-text {
  color: var(--primary);
  font-size: 26rpx;
}

.chip-del {
  color: var(--primary);
  font-size: 32rpx;
  line-height: 1;
  padding: 0 8rpx 0 12rpx;
}

.hint {
  font-size: 24rpx;
  margin-top: 16rpx;
}

.scale-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.scale-opt {
  min-width: 96rpx;
  padding: 12rpx 24rpx;
  text-align: center;
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text);
}

.scale-opt.active {
  border-color: var(--primary);
  background-color: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  border: 2rpx solid var(--border);
  border-radius: 14rpx;
  padding: 22rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background: #fafbff;
}

.preview-label {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.preview-text {
  font-size: 30rpx;
  white-space: pre-wrap;
  word-break: break-all;
  min-height: 40rpx;
}

.divider {
  height: 2rpx;
  background-color: var(--border);
  margin: 24rpx 0;
}
