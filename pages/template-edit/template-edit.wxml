<view class="container">
  <!-- 字段管理 -->
  <view class="card section">
    <text class="form-title">{{i18n.templateEdit.fieldsTitle}}</text>
    <view class="add-field">
      <input class="input" placeholder="{{i18n.templateEdit.newFieldPlaceholder}}" value="{{newField}}" bindinput="onNewFieldInput" />
      <button class="btn btn-sm" size="mini" bindtap="onAddField">{{i18n.templateEdit.addField}}</button>
    </view>
    <view class="chips" wx:if="{{fields.length > 0}}">
      <view class="chip" wx:for="{{fields}}" wx:key="*this">
        <text class="chip-text" data-name="{{item}}" bindtap="onInsertField">{{item}}</text>
        <text class="chip-del" data-name="{{item}}" bindtap="onDeleteField">×</text>
      </view>
    </view>
    <view class="text-muted hint" wx:else>{{i18n.templateEdit.noFields}}</view>
    <view class="text-muted hint" wx:if="{{fields.length > 0}}">{{i18n.templateEdit.fieldsHint}}</view>
  </view>

  <!-- 正面模板 -->
  <view class="card section">
    <text class="form-title">{{i18n.templateEdit.frontTitle}}</text>
    <textarea class="textarea" placeholder="{{i18n.templateEdit.tplPlaceholder}}" value="{{front}}" bindfocus="onFrontFocus" bindinput="onFrontInput" auto-height />
  </view>

  <!-- 背面模板 -->
  <view class="card section">
    <text class="form-title">{{i18n.templateEdit.backTitle}}</text>
    <textarea class="textarea" placeholder="{{i18n.templateEdit.tplPlaceholder}}" value="{{back}}" bindfocus="onBackFocus" bindinput="onBackInput" auto-height />
  </view>

  <!-- 内容放大 -->
  <view class="card section">
    <text class="form-title">{{i18n.templateEdit.scaleTitle}}</text>
    <view class="text-muted hint">{{i18n.templateEdit.scaleHint}}</view>
    <view class="scale-row">
      <view class="scale-opt {{scale === item.value ? 'active' : ''}}" wx:for="{{scaleOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="onScaleChange">{{item.label}}</view>
    </view>
  </view>


  <!-- 预览 -->
  <view class="card section">
    <text class="form-title">{{i18n.templateEdit.previewTitle}}</text>
    <view class="preview-label text-muted">{{i18n.templateEdit.front}}</view>
    <view class="preview-text" style="font-size: {{30 * scale}}rpx">{{preview.front}}</view>
    <view class="divider"></view>
    <view class="preview-label text-muted">{{i18n.templateEdit.back}}</view>
    <view class="preview-text" style="font-size: {{30 * scale}}rpx">{{preview.back}}</view>
  </view>

  <button class="btn" bindtap="onSave">{{i18n.templateEdit.save}}</button>
</view>
