<view class="container study">
  <view class="progress text-muted">{{progressText}}</view>

  <block wx:if="{{current}}">
    <view class="flashcard card" bindtap="onFlip">
      <view class="face-label text-muted">{{i18n.study.front}}</view>
      <view class="face-text" style="font-size: {{48 * scale}}rpx">{{current.front}}</view>

      <block wx:if="{{showBack}}">
        <view class="divider"></view>
        <view class="face-label text-muted">{{i18n.study.back}}</view>
        <view class="face-text" style="font-size: {{48 * scale}}rpx">{{current.back}}</view>
      </block>
      <view class="tap-hint text-muted" wx:else>{{i18n.study.tapHint}}</view>
    </view>

    <!-- 手写练习：练习书写汉字笔画顺序 -->
    <view class="write-toggle">
      <button class="btn btn-outline write-toggle-btn" size="mini" bindtap="onToggleWrite">
        {{showWrite ? i18n.study.hideWrite : i18n.study.showWrite}}
      </button>
    </view>

    <view class="write-pad card" wx:if="{{showWrite}}">
      <view class="write-head">
        <text class="face-label text-muted">{{writeHeadText}}</text>
        <view class="write-tools">
          <button class="btn btn-sm btn-outline" size="mini" bindtap="onSwitchWriteSource">{{writeSource === 'front' ? i18n.study.traceBack : i18n.study.traceFront}}</button>
          <button class="btn btn-sm btn-outline" size="mini" bindtap="onToggleGuide">{{showGuide ? i18n.study.hideGuide : i18n.study.showGuide}}</button>
          <button class="btn btn-sm btn-danger" size="mini" bindtap="onClearWrite">{{i18n.study.clear}}</button>
        </view>
      </view>
      <view class="write-canvas-wrap">
        <!-- 描红引导层：淡色显示待书写内容，方便临摹与练习笔画顺序 -->
        <view class="write-guide face-text" wx:if="{{showGuide}}" style="font-size: {{writeGuideSize}}rpx">{{writeText}}</view>
        <canvas
          type="2d"
          id="writeCanvas"
          class="write-canvas"
          disable-scroll="true"
          bindtouchstart="onWriteStart"
          bindtouchmove="onWriteMove"
          bindtouchend="onWriteEnd"
        ></canvas>
      </view>
      <text class="write-tip text-muted">{{i18n.study.writeTip}}</text>
    </view>

    <view class="rate-bar" wx:if="{{showBack}}">
      <button class="rate-btn again" data-q="0" bindtap="onRate">{{i18n.study.again}}</button>
      <button class="rate-btn hard" data-q="1" bindtap="onRate">{{i18n.study.hard}}</button>
      <button class="rate-btn good" data-q="2" bindtap="onRate">{{i18n.study.good}}</button>
      <button class="rate-btn easy" data-q="3" bindtap="onRate">{{i18n.study.easy}}</button>
    </view>
  </block>

  <view class="finished" wx:elif="{{finished}}">
    <text class="finished-emoji">🎉</text>
    <text class="finished-text">{{i18n.study.finished}}</text>
    <text class="text-muted">{{finishedSubText}}</text>
    <button class="btn" bindtap="onBack">{{i18n.study.backToDecks}}</button>
  </view>
</view>
