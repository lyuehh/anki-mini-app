.study {
  display: flex;
  flex-direction: column;
  min-height: 90vh;
}

.progress {
  text-align: center;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.flashcard {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 480rpx;
  padding: 48rpx;
  margin-bottom: 32rpx;
}

.face-label {
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

.face-text {
  font-size: 48rpx;
  font-weight: 600;
  text-align: center;
  word-break: break-word;
  /* 保留模板/字段内容中的换行与连续空白，否则多行内容会被折叠成一行 */
  white-space: pre-wrap;
}

.divider {
  width: 60%;
  height: 2rpx;
  background-color: var(--border);
  margin: 40rpx 0;
}

.tap-hint {
  margin-top: 40rpx;
  font-size: 24rpx;
}

.rate-bar {
  display: flex;
  gap: 16rpx;
}

.rate-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  color: #fff;
  font-size: 28rpx;
  padding: 0;
}

.rate-btn::after { border: none; }

.again { background-color: #e53e3e; }
.hard { background-color: #dd6b20; }
.good { background-color: #38a169; }
.easy { background-color: #3182ce; }

.finished {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.finished-emoji {
  font-size: 96rpx;
}

.finished-text {
  font-size: 36rpx;
  font-weight: 600;
}

.finished .btn {
  margin-top: 32rpx;
  width: 320rpx;
}
