.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.btn-add {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  border-radius: 30rpx;
  margin: 0;
  box-shadow: 0 6rpx 16rpx rgba(79, 110, 247, 0.28);
}

.btn-add::after {
  border: none;
}

.tpl {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.tpl-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--primary-soft), #f3efff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.tpl-info {
  flex: 1;
  min-width: 0;
}

.tpl-name {
  font-size: 33rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.tpl-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.btn-sm {
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff;
  margin: 0;
  box-shadow: 0 4rpx 12rpx rgba(79, 110, 247, 0.24);
}

.btn-sm::after {
  border: none;
}

.btn-sm.btn-outline {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  box-shadow: none;
}

.btn-sm.btn-danger {
  background: #fff;
  color: var(--danger);
  border: 2rpx solid var(--danger);
  box-shadow: none;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}
