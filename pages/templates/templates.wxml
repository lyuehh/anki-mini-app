<view class="container">
  <view class="header">
    <text class="title">{{i18n.templates.title}}</text>
    <button class="btn btn-add" size="mini" bindtap="onAddTemplate">{{i18n.templates.add}}</button>
  </view>

  <block wx:if="{{templates.length > 0}}">
    <view class="tpl card" wx:for="{{templates}}" wx:key="id">
      <view class="tpl-icon">📝</view>
      <view class="tpl-info">
        <text class="tpl-name">{{item.name}}</text>
        <text class="text-muted">{{item.fieldCountText}}</text>
      </view>
      <view class="tpl-actions">
        <button class="btn btn-sm btn-outline" size="mini" data-id="{{item.id}}" bindtap="onEdit">{{i18n.templates.edit}}</button>
        <button class="btn btn-sm btn-danger" size="mini" data-id="{{item.id}}" bindtap="onDelete">{{i18n.templates.delete}}</button>
      </view>
    </view>
  </block>

  <view class="empty" wx:else>
    <text class="text-muted">{{i18n.templates.empty}}</text>
  </view>
</view>
